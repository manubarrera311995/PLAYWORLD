    "@types/node": "^24.13.3",
    "@types/p5": "^1.7.6",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
